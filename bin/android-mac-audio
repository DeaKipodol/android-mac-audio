#!/bin/zsh
# android-mac-audio — play your Android phone's audio on your Mac's speakers over Wi-Fi (built on scrcpy).
# While any Mac app uses the microphone (e.g. voice input), playback on the phone is paused and then resumed.
# https://github.com/DeaKipodol/android-mac-audio
emulate -L zsh

VERSION=0.1.0
export PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"

SELF=${0:A}
LIBEXEC="${SELF:h:h}/libexec/android-mac-audio"
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/android-mac-audio"
CONFIG="$CONFIG_DIR/config"
LOG_DIR="$HOME/Library/Logs/android-mac-audio"
WINDOW_TITLE="android-mac-audio"
APP_NAME="Android Mac Audio"
LOCAL_NETWORK_PANE="x-apple.systempreferences:com.apple.settings.PrivacySecurity.extension?Privacy_LocalNetwork"

# Defaults. `setup` writes them to the config file, where they can be edited.
DEVICE_SERIAL=""
DEVICE_MODEL=""
AUDIO_BUFFER_MS=400
AUDIO_OUTPUT_BUFFER_MS=10
PAUSE_ON_MIC=1
MIC_IGNORE="com.apple.CoreSpeech"
MIC_ONLY=""
MIC_RELEASE_MS=1000
[[ -f $CONFIG ]] && source "$CONFIG"

# Messages follow the system language: Korean or English.
_lang=${LC_ALL:-${LANG:-$(defaults read -g AppleLocale 2>/dev/null)}}
[[ $_lang == ko* ]] && KO=1 || KO=0
t()   { (( KO )) && print -r -- "$1" || print -r -- "$2"; }
err() { print -r -- "$*" >&2; }
log() { print -r -- "$(date '+%m-%d %H:%M:%S') $*"; }
# zsh's `read "var?prompt"` shows the prompt only in interactive shells, so print it ourselves.
ask() { print -rn -- "$1" >&2; read -r REPLY; }
confirm() {
  ask "$1 [Y/n] "
  [[ -z $REPLY || $REPLY == [Yy]* ]]
}

usage() {
  t "android-mac-audio $VERSION — 안드로이드 폰의 소리를 Wi-Fi로 Mac 스피커에서 듣습니다.

사용법:
  android-mac-audio setup        폰을 페어링하고 등록합니다 (처음 한 번)
  android-mac-audio [start]      소리 전송을 켭니다
  android-mac-audio stop         소리 전송을 끕니다 ('$WINDOW_TITLE' 창을 닫아도 됩니다)
  android-mac-audio status       등록한 폰과 실행 상태를 보여 줍니다
  android-mac-audio app [폴더]   더블클릭으로 켜는 앱을 만듭니다 (기본: ~/Applications)
  android-mac-audio mic-list     지금 마이크를 쓰는 앱을 보여 줍니다

설정 파일: $CONFIG" \
"android-mac-audio $VERSION — play your Android phone's audio on your Mac's speakers over Wi-Fi.

Usage:
  android-mac-audio setup        Pair and register your phone (once)
  android-mac-audio [start]      Start audio forwarding
  android-mac-audio stop         Stop audio forwarding (or close the '$WINDOW_TITLE' window)
  android-mac-audio status       Show the registered phone and whether forwarding is running
  android-mac-audio app [dir]    Create a double-click launcher app (default: ~/Applications)
  android-mac-audio mic-list     Show which apps are using the microphone right now

Config file: $CONFIG"
}

require_tools() {
  local missing=()
  (( $+commands[scrcpy] )) || missing+=scrcpy
  (( $+commands[adb] )) || missing+=adb
  if (( $#missing )); then
    err "$(t "필요한 프로그램이 없습니다: ${missing[*]}" "Missing required tools: ${missing[*]}")"
    err "  brew install scrcpy && brew install --cask android-platform-tools"
    return 1
  fi
}

# macOS blocks connections to devices on the same Wi-Fi with "No route to host"
# when the calling app (Terminal, iTerm, ...) lacks the Local Network permission.
check_local_network() {
  local gw
  gw=$(route -n get default 2>/dev/null | awk '/gateway:/ {print $2}')
  [[ -n $gw ]] || return 0
  if [[ $(ping -c 1 -t 2 "$gw" 2>&1) == *"No route to host"* ]]; then
    err "$(t "이 앱에서 같은 Wi-Fi의 기기에 접속할 수 없습니다 (No route to host).
시스템 설정 > 개인정보 보호 및 보안 > 로컬 네트워크에서 지금 쓰는 터미널 앱(또는 '$APP_NAME')을 켜 주세요." \
"This app cannot reach devices on your Wi-Fi (No route to host).
Turn on your terminal app (or '$APP_NAME') in System Settings > Privacy & Security > Local Network.")"
    open "$LOCAL_NETWORK_PANE" 2>/dev/null
    return 1
  fi
}

is_running() { pgrep -f "scrcpy .*--window-title=$WINDOW_TITLE" >/dev/null; }

prop() { adb -s "$1" shell getprop "$2" </dev/null 2>/dev/null | tr -d '\r'; }

# Print the adb name of the registered phone if it is connected.
find_device() {
  local name state rest
  adb devices 2>/dev/null | while read -r name state rest; do
    [[ $state == device ]] || continue
    if [[ $name == *._adb-tls-connect._tcp ]]; then
      [[ $name == adb-$DEVICE_SERIAL-* ]] && { print -r -- $name; return 0; }
    elif [[ $name == *:* && $(prop "$name" ro.serialno) == $DEVICE_SERIAL ]]; then
      print -r -- $name; return 0
    fi
  done
  return 1
}

# adb usually connects to paired phones on its own (mDNS). If it does not, connect to the advertised address.
wait_for_device() {
  adb start-server >/dev/null 2>&1
  local i addr
  for i in {1..10}; do
    find_device && return 0
    if (( i == 4 )); then
      for addr in $(adb mdns services 2>/dev/null |
          awk -v p="adb-$DEVICE_SERIAL-" '$2 ~ /_adb-tls-connect/ && index($1, p) == 1 {print $3}'); do
        adb connect "$addr" >/dev/null 2>&1
      done
    fi
    sleep 1
  done
  return 1
}

cmd_start() {
  require_tools || return 1
  if [[ -z $DEVICE_SERIAL ]]; then
    err "$(t "등록된 폰이 없습니다. 먼저 'android-mac-audio setup'을 실행하세요." "No phone registered yet. Run 'android-mac-audio setup' first.")"
    return 1
  fi
  if is_running; then
    err "$(t "이미 켜져 있습니다. 끌 때는 '$WINDOW_TITLE' 창을 닫으세요." "Already running. Close the '$WINDOW_TITLE' window to stop.")"
    return 3
  fi
  local dev
  if ! dev=$(wait_for_device); then
    check_local_network || return 1
    err "$(t "폰(${DEVICE_MODEL:-$DEVICE_SERIAL})을 찾지 못했습니다. 폰에서 무선 디버깅을 켰는지, Mac과 같은 Wi-Fi인지 확인하세요." \
             "Phone (${DEVICE_MODEL:-$DEVICE_SERIAL}) not found. Check that Wireless debugging is on and that it is on the same Wi-Fi as your Mac.")"
    return 1
  fi

  mkdir -p "$LOG_DIR"
  nohup scrcpy -s "$dev" --no-video --no-control --window-title="$WINDOW_TITLE" \
    --audio-buffer="$AUDIO_BUFFER_MS" --audio-output-buffer="$AUDIO_OUTPUT_BUFFER_MS" \
    >"$LOG_DIR/scrcpy.log" 2>&1 </dev/null &
  local pid=$!
  sleep 2
  if ! kill -0 $pid 2>/dev/null; then
    err "$(t "소리 전송이 시작되지 않았습니다. 기록: $LOG_DIR/scrcpy.log" "Audio forwarding did not start. Log: $LOG_DIR/scrcpy.log")"
    tail -3 "$LOG_DIR/scrcpy.log" >&2
    return 2
  fi
  if (( PAUSE_ON_MIC )) && [[ -x $LIBEXEC/mic-watch ]]; then
    nohup "$SELF" _mic-loop "$dev" "$pid" >"$LOG_DIR/mic.log" 2>&1 </dev/null &
  fi
  t "소리 전송을 시작했습니다. 끌 때는 '$WINDOW_TITLE' 창을 닫으세요." "Audio forwarding started. Close the '$WINDOW_TITLE' window to stop."
}

# Started by `start`. Pauses the phone while the Mac mic is in use and resumes it afterwards.
# Only resumes playback that it paused itself. Ends when scrcpy (pid) ends.
cmd_mic_loop() {
  local dev=$1 pid=$2 paused=0 state apps
  log "$(t "마이크 감시 시작 (scrcpy PID $pid)" "mic watch started (scrcpy PID $pid)")"
  # adb reads stdin; </dev/null keeps it from eating the watcher's output.
  "$LIBEXEC/mic-watch" --pid "$pid" --ignore "$MIC_IGNORE" --only "$MIC_ONLY" --release-ms "$MIC_RELEASE_MS" |
  while read -r state apps; do
    case $state in
      on)
        if adb -s "$dev" shell dumpsys media_session </dev/null | grep -q 'state=PLAYING'; then
          adb -s "$dev" shell input keyevent KEYCODE_MEDIA_PAUSE </dev/null
          paused=1
          log "$(t "마이크 켜짐 ($apps) → 폰 일시정지" "mic on ($apps) -> paused phone")"
        else
          log "$(t "마이크 켜짐 ($apps) → 재생 중이 아니어서 그대로 둠" "mic on ($apps) -> phone not playing, left as is")"
        fi
        ;;
      off)
        if (( paused )); then
          adb -s "$dev" shell input keyevent KEYCODE_MEDIA_PLAY </dev/null
          paused=0
          log "$(t "마이크 꺼짐 → 폰 이어서 재생" "mic off -> resumed phone")"
        fi
        ;;
    esac
  done
  log "$(t "마이크 감시 종료" "mic watch ended")"
}

cmd_stop() {
  local pids pid i
  pids=($(pgrep -f "scrcpy .*--window-title=$WINDOW_TITLE"))
  if (( ! $#pids )); then
    t "켜져 있지 않습니다." "Not running."
    return 0
  fi
  kill -TERM $pids 2>/dev/null
  # scrcpy handles TERM in its window event loop, which can stall while the window is idle.
  # Give it 3 s, then force it, together with its adb processes (which end the server on the phone).
  for i in {1..12}; do
    is_running || break
    sleep 0.25
  done
  for pid in $pids; do
    kill -0 $pid 2>/dev/null || continue
    pkill -KILL -P $pid 2>/dev/null
    kill -KILL $pid 2>/dev/null
  done
  t "소리 전송을 껐습니다." "Audio forwarding stopped."
}

cmd_status() {
  if [[ -n $DEVICE_SERIAL ]]; then
    t "등록한 폰: ${DEVICE_MODEL:-?} ($DEVICE_SERIAL)" "Registered phone: ${DEVICE_MODEL:-?} ($DEVICE_SERIAL)"
  else
    t "등록한 폰: 없음 — 'android-mac-audio setup'을 실행하세요." "Registered phone: none — run 'android-mac-audio setup'."
  fi
  is_running && t "소리 전송: 켜짐" "Audio forwarding: on" || t "소리 전송: 꺼짐" "Audio forwarding: off"
  print -r -- "$(t "설정 파일" "Config"): $CONFIG"
  print -r -- "$(t "기록" "Logs"): $LOG_DIR"
}

write_config() {
  mkdir -p "$CONFIG_DIR"
  cat >"$CONFIG" <<EOF
# android-mac-audio settings — https://github.com/DeaKipodol/android-mac-audio
DEVICE_SERIAL="$DEVICE_SERIAL"
DEVICE_MODEL="$DEVICE_MODEL"

# Audio buffering in ms. Increase AUDIO_BUFFER_MS if the sound stutters (adds delay, harmless for music).
AUDIO_BUFFER_MS=$AUDIO_BUFFER_MS
AUDIO_OUTPUT_BUFFER_MS=$AUDIO_OUTPUT_BUFFER_MS

# 1 = pause playback on the phone while a Mac app uses the microphone, then resume. 0 = off.
PAUSE_ON_MIC=$PAUSE_ON_MIC
# Apps to ignore, comma-separated bundle IDs (prefix match) or process names.
# com.apple.CoreSpeech listens for "Hey Siri" all the time, so it is ignored by default.
MIC_IGNORE="$MIC_IGNORE"
# Empty = react to any app. Example (Claude app and Claude Code only): "com.anthropic.claudefordesktop,claude"
MIC_ONLY="$MIC_ONLY"
# Resume after the microphone has been idle for this long (ms).
MIC_RELEASE_MS=$MIC_RELEASE_MS
EOF
}

register_device() {
  local dev=$1
  DEVICE_SERIAL=$(prop "$dev" ro.serialno)
  DEVICE_MODEL=$(prop "$dev" ro.product.model)
  if [[ -z $DEVICE_SERIAL ]]; then
    err "$(t "폰 정보를 읽지 못했습니다." "Could not read the phone's details.")"
    return 1
  fi
  write_config
  t "등록했습니다: $DEVICE_MODEL ($DEVICE_SERIAL)" "Registered: $DEVICE_MODEL ($DEVICE_SERIAL)"
}

cmd_setup() {
  require_tools || return 1
  check_local_network || return 1
  adb start-server >/dev/null 2>&1

  local dev model
  dev=$(adb devices 2>/dev/null | awk '$2 == "device" && $1 ~ /_adb-tls-connect\._tcp$/ {print $1; exit}')
  if [[ -n $dev ]]; then
    model=$(prop "$dev" ro.product.model)
    if confirm "$(t "이미 연결된 폰이 있습니다: $model. 이 폰을 등록할까요?" "A phone is already connected: $model. Register it?")"; then
      register_device "$dev" && offer_app
      return
    fi
  fi

  t "
폰에서 다음을 준비하세요 (안드로이드 11 이상):
  1. 설정 > 휴대전화 정보 > 소프트웨어 정보 > 빌드번호를 7번 눌러 개발자 옵션을 켭니다.
  2. 설정 > 개발자 옵션 > 무선 디버깅을 켭니다. 폰과 Mac은 같은 Wi-Fi여야 합니다.
  3. 무선 디버깅 > '페어링 코드로 기기 페어링'을 누르고, 그 창을 띄워 둡니다.
" "
On your phone (Android 11 or later):
  1. Settings > About phone > Software information > tap Build number 7 times to enable Developer options.
  2. Settings > Developer options > turn on Wireless debugging. Phone and Mac must be on the same Wi-Fi.
  3. Wireless debugging > 'Pair device with pairing code', and keep that screen open.
"
  ask "$(t "폰에 표시된 6자리 코드: " "6-digit code shown on the phone: ")"
  local code=${REPLY//[^0-9]/}

  # Find the pairing address the phone advertises on the network (mDNS).
  local line="" instance="" addr="" i
  for i in {1..15}; do
    line=$(adb mdns services 2>/dev/null | awk '$2 ~ /_adb-tls-pairing/ {print $1, $3; exit}')
    [[ -n $line ]] && break
    sleep 1
  done
  if [[ -n $line ]]; then
    instance=${line%% *}
    addr=${line#* }
  else
    ask "$(t "페어링 주소를 자동으로 찾지 못했습니다. 페어링 창의 'IP 주소 및 포트'를 입력하세요 (예: 192.168.0.20:37123): " \
             "Could not find the pairing address automatically. Enter the 'IP address & Port' from the pairing screen (e.g. 192.168.0.20:37123): ")"
    addr=$REPLY
  fi

  if ! adb pair "$addr" "$code"; then
    err "$(t "페어링에 실패했습니다. 코드를 확인하고 다시 시도하세요." "Pairing failed. Check the code and try again.")"
    return 1
  fi

  # After pairing, adb connects to the phone by itself. Fall back to the advertised address if needed.
  dev=""
  for i in {1..15}; do
    dev=$(adb devices 2>/dev/null | awk -v p="$instance" '$2 == "device" && $1 ~ /_adb-tls-connect\._tcp$/ && (p == "" || index($1, p) == 1) {print $1; exit}')
    [[ -n $dev ]] && break
    if (( i == 5 )); then
      for addr in $(adb mdns services 2>/dev/null | awk -v p="$instance" '$2 ~ /_adb-tls-connect/ && (p == "" || $1 == p) {print $3}'); do
        adb connect "$addr" >/dev/null 2>&1
      done
      dev=$(adb devices 2>/dev/null | awk '$2 == "device" && $1 ~ /:[0-9]+$/ {print $1; exit}')
      [[ -n $dev ]] && break
    fi
    sleep 1
  done
  if [[ -z $dev ]]; then
    err "$(t "페어링은 됐지만 연결하지 못했습니다. 잠시 뒤 다시 'android-mac-audio setup'을 실행하세요." \
             "Paired, but could not connect. Try 'android-mac-audio setup' again in a moment.")"
    return 1
  fi
  register_device "$dev" && offer_app
}

offer_app() {
  print
  if confirm "$(t "더블클릭으로 켜는 '$APP_NAME' 앱을 바탕화면에 만들까요?" "Create a double-click '$APP_NAME' launcher on your Desktop?")"; then
    cmd_app "$HOME/Desktop"
  fi
  print
  t "준비가 끝났습니다. 'android-mac-audio'로 켜고, '$WINDOW_TITLE' 창을 닫으면 꺼집니다." \
    "All set. Run 'android-mac-audio' to start; close the '$WINDOW_TITLE' window to stop."
}

cmd_app() {
  local dir=${1:-$HOME/Applications}
  local app="$dir/$APP_NAME.app" tmp
  mkdir -p "$dir"
  tmp=$(mktemp -d)
  cat >"$tmp/launcher.applescript" <<EOF
-- $APP_NAME: runs 'android-mac-audio start' and explains why if it cannot start.
try
	do shell script quoted form of "$SELF" & " start"
on error errMsg
	display dialog errMsg with title "$APP_NAME" buttons {"OK"} default button 1 with icon caution
end try
EOF
  [[ -d $app ]] && rm -rf "$app"
  local out
  out=$(osacompile -o "$app" "$tmp/launcher.applescript" 2>&1) || { err "$out"; rm -rf "$tmp"; return 1; }

  # Use the scrcpy icon when Homebrew provides it.
  local icon="$(brew --prefix 2>/dev/null)/share/icons/hicolor/256x256/apps/scrcpy.png"
  if [[ -f $icon ]] && sips -s format icns "$icon" --out "$tmp/applet.icns" >/dev/null 2>&1; then
    cp "$tmp/applet.icns" "$app/Contents/Resources/applet.icns"
    rm -f "$app/Contents/Resources/Assets.car"
    /usr/libexec/PlistBuddy -c "Delete :CFBundleIconName" "$app/Contents/Info.plist" >/dev/null 2>&1
  fi
  codesign --force --deep -s - "$app" >/dev/null 2>&1
  touch "$app"
  rm -rf "$tmp"
  t "앱을 만들었습니다: $app" "Created: $app"
  t "  처음 실행할 때 로컬 네트워크 접근을 물으면 '허용'을 누르세요." "  If asked about Local Network access on first launch, click Allow."
}

cmd_mic_list() {
  [[ -x $LIBEXEC/mic-watch ]] || { err "mic-watch not found: $LIBEXEC/mic-watch"; return 1; }
  "$LIBEXEC/mic-watch" --list --ignore "$MIC_IGNORE" --only "$MIC_ONLY"
}

case ${1:-start} in
  start)          cmd_start ;;
  stop)           cmd_stop ;;
  setup)          cmd_setup ;;
  status)         cmd_status ;;
  app)            cmd_app "$2" ;;
  mic-list)       cmd_mic_list ;;
  _mic-loop)      cmd_mic_loop "$2" "$3" ;;
  -v|--version)   print -r -- "android-mac-audio $VERSION" ;;
  -h|--help|help) usage ;;
  *)              usage >&2; exit 64 ;;
esac
